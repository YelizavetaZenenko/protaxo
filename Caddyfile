{
	# Немає публічного домену, тому вимикаємо звичайний ACME (Let's Encrypt) —
	# він все одно не спрацює без порту 80/443, відкритого в реальний інтернет.
	auto_https off
}

{$APP_DOMAIN} {
	# Справжній Let's Encrypt-сертифікат для *.ts.net-домену, випущений
	# `tailscale cert` прямо на хості VPS (не самопідписаний) — без попереджень
	# браузера. Файли лежать на хості в /opt/protaxo/certs, змонтовані в
	# контейнер caddy як /certs (див. docker-compose.prod.yml).
	tls /certs/cert.pem /certs/key.pem

	reverse_proxy app:8080

	# WebSocket для Print Agent (/ws/print-agent) проксується автоматично —
	# reverse_proxy в Caddy 2 сам розпізнає Upgrade-заголовок, окремих
	# налаштувань не потрібно. Див. docs/Print Agent.md.

	encode gzip

	# Поки контейнер app недоступний (деплой, перезапуск) — замість голої помилки 502 віддаємо
	# сторінку «Технічні роботи» (/srv/maintenance.html, змонтована з репозиторію, див.
	# docker-compose.prod.yml). Режим робіт, увімкнений адміністратором, обробляє вже сам
	# застосунок. Див. docs/Технічні роботи.md.
	handle_errors 502 503 504 {
		rewrite * /maintenance.html
		file_server {
			root /srv
		}
	}

	log {
		output file /data/access.log
	}
}

# Публічна перевірка протоколу за QR (для будь-кого, без Tailscale) — див.
# docs/Print Agent.md "Публічний доступ через Tailscale Funnel". Просте HTTP,
# без TLS: слухає лише 127.0.0.1 хоста (docker-compose.prod.yml), TLS для
# зовнішнього трафіку термінує сам tailscaled на боці Funnel, сюди долітає вже
# розшифрований HTTP. Навмисно вузько — лише /verify/*, усе інше 404.
:8081 {
	@verify path /verify/*
	handle @verify {
		reverse_proxy app:8080 {
			# Сюди долітає вже розшифрований HTTP від tailscaled, але зовні був HTTPS (:8443) —
			# кажемо застосунку правду, щоб його редиректи вели на https:// (forward-headers-strategy).
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		respond 404
	}

	log {
		output file /data/funnel-access.log
	}
}
