# Копія цього файлу в .env (не комітиться, див. .gitignore) з реальними
# значеннями заповнюється прямо на VPS перед першим запуском docker-compose.prod.yml.

# Пароль Postgres — новий, не той що для локальної розробки (lizaliza123).
DB_PASSWORD=

# Tailscale IP цього VPS (`tailscale ip -4` після приєднання до tailnet).
# Caddy слухає 80/443 тільки на цій адресі, не на публічному інтерфейсі.
TAILSCALE_IP=

# Домен, на якому Caddy піднімає HTTPS: MagicDNS-ім'я машини в tailnet
# (напр. protaxo-vps.tailxxxxx.ts.net) — доступне лише всередині Tailscale-мережі.
APP_DOMAIN=

# Той самий домен з https:// — використовується для посилань-запрошень
# (${app.base-url}/accept-invite?token=...), див. docs/Реєстрація акаунтів (запрошення).md.
APP_BASE_URL=https://

# Реальний SMTP замість MailHog, див. docs/Реєстрація акаунтів (запрошення).md.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Той самий токен, що прописаний у print-agent/printagent.properties на комп'ютері СТО.
PRINT_AGENT_TOKEN=
