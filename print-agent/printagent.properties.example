# Скопіюйте цей файл у printagent.properties (той самий каталог, поруч із print-agent.jar) і
# заповніть значення. printagent.properties НЕ комітиться в git (реальний токен — секрет).
# Зручніше міняти все у вікні програми (відкривається при запуску) — кнопка «Зберегти»
# перезаписує цей файл. Без вікна: java -jar print-agent.jar --nogui

# Адреса WebSocket-ендпоінта бекенду. Для віддаленого сервера — wss://ваш-домен/ws/print-agent
backend.ws.url=ws://localhost:8080/ws/print-agent

# Має ЗБІГАТИСЬ з print-agent.token бекенду (application.properties / змінна середовища
# PRINT_AGENT_TOKEN). Це єдиний захист WebSocket-ендпоінта — тримайте в секреті.
token=dev-print-agent-token

# Назва принтера так, як вона написана у Windows ("Принтери та сканери"), наприклад "Godex G500".
# Спершу шукається точний збіг, потім — входження підрядка. Порожньо — принтер за замовчуванням.
printer.name=Godex G500

# Як наклейка йде на принтер: ezpl (рідна мова Godex G500) / zpl / epl — сирі команди з розміром
# етикетки всередині, драйвер не обрізає; або driver (картинкою через драйвер Windows).
# Див. docs/Print Agent.md.
printer.language=ezpl

# Етикетка на рулоні: ширина ПОПЕРЕК стрічки, довжина ВЗДОВЖ стрічки, проміжок — у мм.
label.width.mm=81.5
label.length.mm=47.5
label.gap.mm=3.0

# Поворот наклейки за годинниковою стрілкою: 0, 90, 180 або 270. Для рулону, де наклейки
# лежать "боком" (довга сторона поперек стрічки) — 90 або 270.
label.rotation=90

# Масштаб картинки всередині етикетки, % (100 — як прийшла з сервера; менше — якщо краї обрізаються).
label.scale.percent=92

# Зсув вмісту всередині етикетки, мм (+X — поперек стрічки, +Y — вздовж).
label.offset.x.mm=0.0
label.offset.y.mm=0.0

# Темність друку 1..15; 0 — як налаштовано в самому принтері.
label.darkness=0

# true — поміняти чорне й біле місцями (якщо принтер друкує «негативом»).
label.invert=false

# true — наклейка з сайту не друкується одразу, а чекає у вікні кнопки «Друкувати»
# (можна спершу переглянути й підправити налаштування). Без вікна (--nogui) друкується одразу.
print.confirm=false
