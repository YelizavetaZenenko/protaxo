<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Свідомо НЕ модуль головного reactor'а (D:\protaxo\pom.xml не оголошує <modules>) — окремий,
        повністю незалежний Maven-проєкт, що збирається/запускається окремо від Spring Boot
        застосунку. Жодних зовнішніх залежностей: WebSocket-клієнт (java.net.http.WebSocket) і
        друк сирих байтів (javax.print) — обидва вже в самому JDK 21. Див. docs/Print Agent.md.
    -->
    <groupId>com.example</groupId>
    <artifactId>print-agent</artifactId>
    <!--
        Версія програми друку для АВТООНОВЛЕННЯ (docs/Print Agent.md): встановлені програми порівнюють
        свою версію з цією й оновлюються, коли тут більше. Підвищуйте її (1.0.0 → 1.0.1 …) щоразу,
        коли змінюєте код print-agent; без зміни коду не чіпайте — інакше всі програми зайво перезапустяться.
    -->
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm</maven.build.timestamp.format>
    </properties>

    <build>
        <finalName>print-agent</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.example.printagent.PrintAgentMain</mainClass>
                        </manifest>
                        <!-- Дата збірки — показується на сайті біля кнопки «Завантажити» (docs/Print Agent.md). -->
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
